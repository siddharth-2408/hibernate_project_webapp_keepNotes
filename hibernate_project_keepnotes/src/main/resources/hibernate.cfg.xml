<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration SYSTEM
"http://hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
	<session-factory>
		<property name="connection.driver_class">com.mysql.jdbc.Driver</property>
		<property name="connection.url">jdbc:mysql://localhost:3306/hibernate_project_keepnotes</property>
		<property name="connection.username">root</property>
		<property name="connection.password">root</property>
		<property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>
		<!-- For creating table -->
		<property name="hbm2ddl.auto">create<!-- creates table first then updates it again and again --></property>
								  <!--create: Creates new table everytime -->
		<property name="show_sql">true</property>
		<property name="format_sql">true</property>
		
		<mapping class ="com.entity.KeepNotesData"/>
	</session-factory>
</hibernate-configuration>